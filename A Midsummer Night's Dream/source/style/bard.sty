% Speech command - handles both verse (with \\) and prose (without)
% \speech[Speaker][Addressee]{text}
\NewDocumentCommand{\speech}{o o +m}{%
    \goodbreak\par
    \needspace{3\baselineskip}%
    \vspace{\speakerspace}%
    \IfValueT{#1}{%
        \centering\character{#1}\par
        \nobreak\penalty10000
    }%
    \IfValueT{#2}{%
        \begingroup
        \leftskip=\textindent
        \rightskip=0pt plus 1fil
        \noindent\textit{(To~\character{#2})}\par
        \endgroup
        \nobreak\penalty10000
    }%
    \begingroup
    \leftskip=\textindent
    \parindent=0pt
    \parfillskip=0pt plus1fil
    \ignorespaces#3\par
    \endgroup
}

% Aside handling
% The syntax for this is weird, unavoidably. Each command has an optional argument that represents a previous line--that is, if a character's speech begins by completing the previous speaker's line--that's used to set the horizontal space.
%
% \speech[Prospero]{\aside[I ever saw so noble.]{It goes on, I see...}}:
%	* Prospero is speaking. 
% * His speech is an aside. (\aside{})
% * Prospero's line "It goes on..." will be indented by the width of "I ever saw so noble." (Miranda's line that he is completing) MINUS the width of the "[Aside]" label.
% 
% Things get more complicated with \asideto. Whitespace added for clarity:
% \speech[Sebastian]{
%	\asideto[That you resolved to effect.]{Antonio}{
%		The next advantage\\ Will we take throughly.
%	}
% }
% * Sebastian is speaking
% * His speech is an aside to Antonio
% * His speech completes somebody else's line "That you resolved to effect."
% * His speech will be indented by the width of "That you resolved to effect" MINUS the width of the "[Aside to ANTONIO]" label


\newcommand{\aside}[2][]{%
    \if\relax\detokenize{#1}\relax
        \par\noindent\normalfont\textit{[Aside]}~\textit{#2}%
    \else
		\par\noindent\normalfont\textit{[Aside]~}
        \hspace{\widthof{#1}-\widthof{[Aside]~}}%
        \textit{#2}%
    \fi
}

\newcommand{\asideto}[3][]{%
    \if\relax\detokenize{#1}\relax
        \par\noindent\normalfont\textit{[Aside~to~\character{#2}]}~\textit{#3}%
    \else
        \par\noindent\normalfont\textit{[Aside~to~\character{#2}]~}
		\hspace{\widthof{#1}-\widthof{[Aside~to~\character{#2}]~}}%
        \textit{#3}%
    \fi
}

% Stage directions aligned with text
\newcommand{\stage}[1]{%
    \ifvmode
        \par
    \else
        \unskip
        \par
    \fi
    \needspace{2\baselineskip}% Stage direction + following line
    \vspace{\stagespace}%
    \begingroup
    \leftskip=\textindent
    \rightskip=0pt plus 1fil
    \noindent\textit{(#1)}%
    \par
    \endgroup
    \ignorespaces%
}

% All stage directions use the same format
\newcommand{\stagedir}[1]{\stage{#1}}


% All new, all singing, all dancing \exit command! Now can count!
% The star versions print "Enter" (or "Exit") followed by a string that the commands do not attempt to format. This allows for flexibility, but does require you to mark any character names with \character{}, whereas the non-starred versions will do that for you.
% \enter{Romeo,Juliet}  -> (Enter ROMEO and JULIET.)
% \enter*{\character{Ferdinand,} bearing a pile of logs.} -> (Enter FERDINAND, bearing a pile of logs.)
% \exit{} (with no arguments) prints "(Exeunt omnes.)" There is no corresponding \enter{} command.

\ExplSyntaxOn

\seq_new:N \l_exit_seq

\cs_new:Npn \__stage_format_seq:N #1 {
  \int_set:Nn \l_tmpa_int { \seq_count:N #1 }
  \seq_indexed_map_inline:Nn #1 {
    \int_compare:nTF { ##1 = 1 }
      { \character{##2} }
      {
        \int_compare:nTF { ##1 = \l_tmpa_int }
          { ~and~\character{##2} }
          { ,~\character{##2} }
      }
  }
}

\NewDocumentCommand{\exit}{s m}{%
  \IfBooleanTF{#1}
    { \stage{Exit~#2} }
    {
      \tl_if_blank:nTF {#2}
        {\smallskip\stage{Exeunt~omnes.} }
        {
          \seq_set_split:Nnn \l_exit_seq {,} {#2}
          \int_compare:nTF { \seq_count:N \l_exit_seq = 1 }
            { \stage{Exit~\__stage_format_seq:N \l_exit_seq.} }
            { \stage{Exeunt~\__stage_format_seq:N \l_exit_seq.} }
        }
    }
  \goodbreak
}

\NewDocumentCommand{\enter}{s m}{%
  \IfBooleanTF{#1}
    { \goodbreak\stage{Enter~#2} }
    {
      \seq_set_split:Nnn \l_exit_seq {,} {#2}
      \goodbreak\stage{Enter~\__stage_format_seq:N \l_exit_seq.}
    }
}

\ExplSyntaxOff







